# ============================================================
# .env.example — copy this file to ".env" and fill in your values
# Used by: extraction scripts, clickhouse scripts, docker-compose
# ============================================================

# ---- PostgreSQL (source DB, installed locally on your PC) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Projet_bts
DB_USER=postgres
DB_PASS=YOUR_POSTGRES_PASSWORD

# ---- Paths used by extraction / data_quality scripts ----
# Leave these commented to use the defaults (./data/raw and ./logs
# relative to the project root). Override only if you keep your
# raw Excel files somewhere else.
# RAW_DATA_DIR=./data/raw
# LOG_DIR=./logs

# ---- ClickHouse (used by docker-compose + clickhouse/*.py scripts) ----
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=admin123

# ---- Chatbot backend (Groq LLM) ----
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile